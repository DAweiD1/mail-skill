#!/usr/bin/env python3
"""mail-to-calendar 的邮箱读取工具。

只读设计：SELECT readonly=True + BODY.PEEK[]，不会改变邮件已读状态，也不会删除任何东西。
凭据只从配置文件读取，任何时候都不打印、不回显。

用法：
    mail check                     检查账号能否登录
    mail fetch --days 7            拉最近 7 天里疑似含时间信息的邮件
    mail fetch --days 7 --json     同上，输出 JSON 给 agent / 其他程序用
"""

import argparse
import base64
import email
import imaplib
import json
import os
import re
import sys
from datetime import datetime, timedelta
from email.header import decode_header, make_header
from email.utils import parsedate_to_datetime

# 163 的 IMAP 在登录后必须发 ID 命令，否则会被判定为异常客户端直接断开
imaplib.Commands["ID"] = ("NONAUTH", "AUTH", "SELECTED")
ID_ARGS = '("name" "mail-to-calendar" "version" "1.0" "vendor" "local" "contact" "local")'

DEFAULT_CONFIG = "~/.config/mail-to-calendar/account.txt"

# 常见邮箱的 IMAP 服务器。不在表里的域名按 imap.<域名> 猜，猜错就用配置里的 host 覆盖。
HOST_PRESETS = {
    "163.com": "imap.163.com",
    "126.com": "imap.126.com",
    "yeah.net": "imap.yeah.net",
    "188.com": "imap.188.com",
    "qq.com": "imap.qq.com",
    "foxmail.com": "imap.qq.com",
    "exmail.qq.com": "imap.exmail.qq.com",
    "gmail.com": "imap.gmail.com",
    "googlemail.com": "imap.gmail.com",
    "outlook.com": "outlook.office365.com",
    "hotmail.com": "outlook.office365.com",
    "live.com": "outlook.office365.com",
    "sina.com": "imap.sina.com",
    "sohu.com": "imap.sohu.com",
    "aliyun.com": "imap.aliyun.com",
}

# 命中这些词的邮件才会被当成「可能含日程」输出，避免把整箱邮件灌进上下文
SCHEDULE_HINTS = (
    "会议", "面试", "预约", "航班", "机票", "酒店", "预定", "预订", "时间", "安排",
    "日程", "报名", "截止", "ddl", "提醒", "考试", "笔试", "测评", "上课", "讲座",
    "签到", "入职", "体检", "续费", "到期", "缴费", "行程",
    "meeting", "interview", "booking", "flight", "reservation", "deadline",
    "schedule", "appointment", "invitation", "exam", "due", "reminder",
)


def die(msg, hint=None, code=1):
    print(msg, file=sys.stderr)
    if hint:
        print(hint, file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- 配置

def load_config(path):
    p = os.path.expanduser(path)
    if not os.path.exists(p):
        die(
            "找不到配置文件：%s" % p,
            "复制仓库里的 config.example.txt 到该路径，填好 user 和 password 再试",
        )
    with open(p, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()

    cfg = {}
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, value = line.split("=", 1)
            cfg[key.strip().lower()] = value.strip()

    # 兼容「第一行账号、第二行授权码」的极简写法
    if "user" not in cfg:
        bare = [ln.strip() for ln in lines if ln.strip() and not ln.strip().startswith("#")]
        if len(bare) >= 2:
            cfg["user"] = bare[0]
            cfg["password"] = bare[-1]

    if not cfg.get("user"):
        die("配置里缺少 user（邮箱地址）")
    if not cfg.get("password"):
        die("配置里缺少 password（163 等邮箱要用网页端生成的授权码，不是登录密码）")

    cfg["folder"] = cfg.get("folder") or "INBOX"
    cfg["port"] = int(cfg.get("port") or 993)
    if not cfg.get("host"):
        domain = cfg["user"].split("@")[-1].lower()
        cfg["host"] = HOST_PRESETS.get(domain, "imap." + domain)
    return cfg


# ---------------------------------------------------------------- 连接

def connect(cfg):
    host, port = cfg["host"], cfg["port"]
    try:
        conn = imaplib.IMAP4_SSL(host, port, timeout=20)
    except Exception as exc:
        die(
            "连不上 %s:%d（%s）" % (host, port, exc),
            "检查 host/port 是否写对；公司或学校网络可能封了 993 端口",
        )

    try:
        conn.login(cfg["user"], cfg["password"])
    except imaplib.IMAP4.error as exc:
        die(
            "登录失败：%s" % str(exc).splitlines()[0],
            "两种可能：1) 密码/授权码不对；2) 邮箱网页端没开启 IMAP 服务。\n"
            "163/126/188：设置 → POP3/SMTP/IMAP → 开启 IMAP 并生成授权码\n"
            "QQ：设置 → 账户 → POP3/IMAP 服务 → 开启并生成授权码\n"
            "Gmail：需要「应用专用密码」，普通密码登不上",
        )

    # 163/126 不发 ID 会被当作异常客户端，后续命令直接报 Unsafe Login
    try:
        conn._simple_command("ID", ID_ARGS)
    except Exception:
        pass

    return conn


# ---------------------------------------------------------------- 解析

def decode_mime(value):
    if not value:
        return ""
    try:
        return str(make_header(decode_header(value)))
    except Exception:
        return value


def decode_folder(name):
    """IMAP 文件夹名用 modified UTF-7 编码，中文会变成 &XfJT0ZAB- 这种，解回来才看得懂。"""

    def repl(match):
        chunk = match.group(1)
        if not chunk:
            return "&"
        b64 = chunk.replace(",", "/")
        b64 += "=" * (-len(b64) % 4)
        try:
            return base64.b64decode(b64).decode("utf-16-be")
        except Exception:
            return match.group(0)

    return re.sub(r"&([^-]*)-", repl, name)


def decode_payload(part):
    payload = part.get_payload(decode=True) or b""
    charset = (part.get_content_charset() or "").lower()
    candidates = [charset] if charset else []
    candidates += ["utf-8", "gb18030", "big5", "latin-1"]
    for enc in candidates:
        if not enc:
            continue
        try:
            return payload.decode(enc)
        except (LookupError, UnicodeDecodeError):
            continue
    return payload.decode("utf-8", errors="replace")


def body_text(msg, limit):
    plain = html = None
    for part in msg.walk():
        if "attachment" in str(part.get("Content-Disposition") or ""):
            continue
        ctype = part.get_content_type()
        if ctype == "text/plain" and plain is None:
            plain = part
        elif ctype == "text/html" and html is None:
            html = part

    target = plain or html
    if target is None:
        return ""
    text = decode_payload(target)
    if target is html:
        text = re.sub(r"<(script|style).*?</\1>", " ", text, flags=re.S | re.I)
        text = re.sub(r"<[^>]+>", " ", text)
        text = text.replace("&nbsp;", " ").replace("&ldquo;", "「").replace("&rdquo;", "」")
    text = re.sub(r"[ \t\r\f\v]+", " ", text)
    text = re.sub(r"\n\s*\n+", "\n", text)
    return text.strip()[:limit]


def ics_attachments(msg):
    names = []
    for part in msg.walk():
        if part.get_content_type() == "text/calendar":
            names.append(decode_mime(part.get_filename()) or "calendar.ics")
        elif (part.get_filename() or "").lower().endswith(".ics"):
            names.append(decode_mime(part.get_filename()))
    return names


def iso_date(header_value, fallback):
    if header_value:
        try:
            return parsedate_to_datetime(header_value).isoformat()
        except Exception:
            pass
    return fallback


# ---------------------------------------------------------------- 命令

def cmd_check(cfg, args):
    conn = connect(cfg)
    status, data = conn.select(cfg["folder"], readonly=True)
    if status != "OK":
        die("打不开邮箱文件夹 %s：%s" % (cfg["folder"], data))

    total = data[0].decode() if data and data[0] else "?"
    status, folders = conn.list()
    folder_names = []
    if status == "OK":
        for raw in folders:
            text = raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else str(raw)
            match = re.search(r'"([^"]*)"\s*$', text) or re.search(r"(\S+)\s*$", text)
            if match:
                folder_names.append(decode_folder(match.group(1)))

    since = (datetime.now() - timedelta(days=7)).strftime("%d-%b-%Y")
    status, recent = conn.search(None, "(SINCE %s)" % since)
    recent_count = len(recent[0].split()) if status == "OK" and recent and recent[0] else 0

    conn.logout()

    result = {
        "ok": True,
        "host": cfg["host"],
        "port": cfg["port"],
        "user": cfg["user"],
        "folder": cfg["folder"],
        "messages_in_folder": total,
        "messages_last_7_days": recent_count,
        "folders": folder_names,
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print("连接成功：%s → %s:%d" % (cfg["user"], cfg["host"], cfg["port"]))
        print("文件夹 %s：共 %s 封，最近 7 天 %d 封" % (cfg["folder"], total, recent_count))
        print("其他文件夹：%s" % (", ".join(folder_names) if folder_names else "（无）"))


def cmd_fetch(cfg, args):
    conn = connect(cfg)
    status, _ = conn.select(cfg["folder"], readonly=True)
    if status != "OK":
        die("打不开邮箱文件夹 %s" % cfg["folder"])

    since = (datetime.now() - timedelta(days=args.days)).strftime("%d-%b-%Y")
    status, data = conn.search(None, "(SINCE %s)" % since)
    if status != "OK":
        die("搜索失败：%s" % data)

    all_uids = data[0].split() if data and data[0] else []
    uids = all_uids[-args.limit:]
    messages = []

    for uid in reversed(uids):
        status, fetched = conn.fetch(uid, "(BODY.PEEK[])")
        if status != "OK" or not fetched or not isinstance(fetched[0], tuple):
            continue
        msg = email.message_from_bytes(fetched[0][1])
        subject = decode_mime(msg.get("Subject"))
        sender = decode_mime(msg.get("From"))
        text = body_text(msg, args.chars)
        ics = ics_attachments(msg)

        if args.no_filter:
            relevant = True
        else:
            haystack = (subject + "\n" + text).lower()
            relevant = bool(ics) or any(h.lower() in haystack for h in SCHEDULE_HINTS)
        if not relevant:
            continue

        messages.append(
            {
                "uid": uid.decode() if isinstance(uid, bytes) else str(uid),
                "date": iso_date(msg.get("Date"), iso_date(msg.get("Received"), "")),
                "from": sender,
                "subject": subject,
                "ics": ics,
                "text": text,
            }
        )

    conn.logout()

    payload = {
        "ok": True,
        "account": cfg["user"],
        "host": cfg["host"],
        "folder": cfg["folder"],
        "days": args.days,
        "scanned": len(uids),
        "matched": len(messages),
        "messages": messages,
    }

    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return

    print("# %s｜%s｜最近 %d 天，扫 %d 封，命中 %d 封"
          % (cfg["user"], cfg["host"], args.days, len(uids), len(messages)))
    print()
    for index, item in enumerate(messages, 1):
        print("## [%d] %s" % (index, item["date"]))
        print("发件人：%s" % item["from"])
        print("主题：%s" % item["subject"])
        if item["ics"]:
            print("附件(ics)：%s" % ", ".join(item["ics"]))
        print("正文：")
        print(item["text"] or "（无纯文本正文）")
        print()


def main():
    parser = argparse.ArgumentParser(
        prog="mail",
        description="只读读取邮箱，供 agent 抽取日程后写进日历",
    )
    parser.add_argument("--config", default=DEFAULT_CONFIG, help="配置文件路径")
    sub = parser.add_subparsers(dest="command")

    check = sub.add_parser("check", help="检查账号能否登录")
    check.add_argument("--json", action="store_true")

    fetch = sub.add_parser("fetch", help="拉取疑似含时间信息的邮件")
    fetch.add_argument("--days", type=int, default=7)
    fetch.add_argument("--limit", type=int, default=60, help="最多检查多少封")
    fetch.add_argument("--chars", type=int, default=700, help="每封正文最多保留多少字符")
    fetch.add_argument("--json", action="store_true")
    fetch.add_argument("--no-filter", action="store_true", help="不做关键词过滤，全部输出")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    cfg = load_config(args.config)
    if args.command == "check":
        cmd_check(cfg, args)
    else:
        cmd_fetch(cfg, args)


if __name__ == "__main__":
    main()
