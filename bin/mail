#!/usr/bin/env python3
"""mail —— 通用邮箱只读工具（IMAP）。

设计原则：
  * 只读。SELECT readonly=True + BODY.PEEK[]，不改已读状态、不删信、不发信。
  * 凭据只从配置文件读，任何输出里都不出现。
  * 列表便宜、正文按需取 —— 让调用方（agent 或人）自己控制读多少。

命令：
  mail check                       账号连通性
  mail folders                     文件夹列表
  mail search   [过滤条件]          邮件列表（不含正文）
  mail read     --uid N[,N]        读正文
  mail save     --uid N --out 路径  存成 .md 或 .eml
  mail attach   --uid N --out 目录  下载附件

所有命令都支持 --json。
"""

import argparse
import base64
import email
import imaplib
import json
import os
import re
import sys
from datetime import datetime, timedelta
from email.header import decode_header, make_header
from email.utils import parsedate_to_datetime

# 163/126 的 IMAP 登录后不发 ID 会被当异常客户端断开
imaplib.Commands["ID"] = ("NONAUTH", "AUTH", "SELECTED")
ID_ARGS = '("name" "mail-cli" "version" "2.0" "vendor" "local" "contact" "local")'

DEFAULT_CONFIG = "~/.config/mail/account.txt"
LEGACY_CONFIG = "~/.config/mail-to-calendar/account.txt"   # 旧路径，兼容早期安装

HOST_PRESETS = {
    "163.com": "imap.163.com",
    "126.com": "imap.126.com",
    "yeah.net": "imap.yeah.net",
    "188.com": "imap.188.com",
    "qq.com": "imap.qq.com",
    "foxmail.com": "imap.qq.com",
    "gmail.com": "imap.gmail.com",
    "googlemail.com": "imap.gmail.com",
    "outlook.com": "outlook.office365.com",
    "hotmail.com": "outlook.office365.com",
    "live.com": "outlook.office365.com",
    "sina.com": "imap.sina.com",
    "sohu.com": "imap.sohu.com",
    "aliyun.com": "imap.aliyun.com",
}

MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
          "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]


def die(msg, hint=None, code=1):
    print(msg, file=sys.stderr)
    if hint:
        print(hint, file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- 配置

def load_config(path):
    p = os.path.expanduser(path)
    if not os.path.exists(p) and os.path.expanduser(LEGACY_CONFIG) != p:
        legacy = os.path.expanduser(LEGACY_CONFIG)
        if os.path.exists(legacy):
            p = legacy
    if not os.path.exists(p):
        die("找不到配置文件：%s" % p,
            "复制仓库里的 config.example.txt 到该路径，填 user 和 password")
    with open(p, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()

    cfg = {}
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, value = line.split("=", 1)
            cfg[key.strip().lower()] = value.strip()

    if "user" not in cfg:  # 兼容「第一行账号、第二行授权码」
        bare = [ln.strip() for ln in lines if ln.strip() and not ln.strip().startswith("#")]
        if len(bare) >= 2:
            cfg["user"], cfg["password"] = bare[0], bare[-1]

    if not cfg.get("user"):
        die("配置里缺少 user")
    if not cfg.get("password"):
        die("配置里缺少 password（163 等邮箱要填网页端生成的授权码，不是登录密码）")

    cfg["folder"] = cfg.get("folder") or "INBOX"
    cfg["port"] = int(cfg.get("port") or 993)
    if not cfg.get("host"):
        domain = cfg["user"].split("@")[-1].lower()
        cfg["host"] = HOST_PRESETS.get(domain, "imap." + domain)
    return cfg


def connect(cfg):
    try:
        conn = imaplib.IMAP4_SSL(cfg["host"], cfg["port"], timeout=20)
    except Exception as exc:
        die("连不上 %s:%d（%s）" % (cfg["host"], cfg["port"], exc),
            "检查 host/port；公司或学校网络可能封了 993 端口")
    try:
        conn.login(cfg["user"], cfg["password"])
    except imaplib.IMAP4.error as exc:
        die("登录失败：%s" % str(exc).splitlines()[0],
            "1) 密码/授权码不对；2) 网页端没开 IMAP。\n"
            "163/126/188：设置 → POP3/SMTP/IMAP → 开启并生成授权码\n"
            "QQ：设置 → 账户 → POP3/IMAP 服务 → 开启并生成授权码\n"
            "Gmail：要「应用专用密码」")
    try:
        conn._simple_command("ID", ID_ARGS)
    except Exception:
        pass
    return conn


# ---------------------------------------------------------------- 编码

def decode_mime(value):
    if not value:
        return ""
    try:
        return str(make_header(decode_header(value)))
    except Exception:
        return value


def decode_folder(name):
    """IMAP 文件夹名是 modified UTF-7，中文显示成 &XfJT0ZAB- 这种。"""

    def repl(match):
        chunk = match.group(1)
        if not chunk:
            return "&"
        b64 = chunk.replace(",", "/")
        b64 += "=" * (-len(b64) % 4)
        try:
            return base64.b64decode(b64).decode("utf-16-be")
        except Exception:
            return match.group(0)

    return re.sub(r"&([^-]*)-", repl, name)


def encode_folder(name):
    """反方向：把中文文件夹名编成 IMAP 线上的写法。"""
    out, buf = [], []

    def flush():
        if buf:
            raw = "".join(buf).encode("utf-16-be")
            b64 = base64.b64encode(raw).decode().rstrip("=").replace("/", ",")
            out.append("&" + b64 + "-")
            del buf[:]

    for ch in name:
        if 0x20 <= ord(ch) <= 0x7E:
            flush()
            out.append("&" if ch == "&" else ch)
        else:
            buf.append(ch)
    flush()
    return "".join(out)


def decode_payload(part):
    payload = part.get_payload(decode=True) or b""
    charset = (part.get_content_charset() or "").lower()
    for enc in [charset, "utf-8", "gb18030", "big5", "latin-1"]:
        if not enc:
            continue
        try:
            return payload.decode(enc)
        except (LookupError, UnicodeDecodeError):
            continue
    return payload.decode("utf-8", errors="replace")


# ---------------------------------------------------------------- IMAP 时间

def imap_date(text):
    """接受 2026-11-01 / -7d / today，输出 IMAP 的 DD-Mon-YYYY。"""
    text = (text or "").strip()
    if not text:
        return None
    if text == "today":
        day = datetime.now()
    elif re.fullmatch(r"-?\d+d", text):
        day = datetime.now() - timedelta(days=int(text.strip("-")[:-1]))
    else:
        try:
            day = datetime.strptime(text, "%Y-%m-%d")
        except ValueError:
            die("日期格式看不懂：%s（要 2026-11-01 / 7d / today）" % text)
    return "%02d-%s-%04d" % (day.day, MONTHS[day.month - 1], day.year)


def human_date(text):
    if not text:
        return ""
    try:
        dt = parsedate_to_datetime(text)
        return dt.strftime("%Y-%m-%d %H:%M")
    except Exception:
        return text


# ---------------------------------------------------------------- 取信

def fetch_message(conn, uid):
    """返回 (raw bytes, flags 字符串)。"""
    status, data = conn.fetch(uid, "(FLAGS BODY.PEEK[])")
    if status != "OK" or not data:
        return None
    meta, raw = None, None
    for item in data:
        if isinstance(item, tuple):
            meta = item[0].decode("utf-8", errors="replace")
            raw = item[1]
    if raw is None:
        return None
    flags = re.search(r"FLAGS \(([^)]*)\)", meta or "")
    return raw, (flags.group(1) if flags else "")


def describe(msg, uid, flags, chars):
    text = body_text(msg, chars)
    attachments = []
    for part in msg.walk():
        name = part.get_filename()
        if name:
            attachments.append({"name": decode_mime(name),
                                "type": part.get_content_type()})
    return {
        "uid": uid,
        "date": human_date(msg.get("Date")),
        "from": decode_mime(msg.get("From")),
        "to": decode_mime(msg.get("To")),
        "subject": decode_mime(msg.get("Subject")),
        "unread": "\\Seen" not in flags,
        "attachments": attachments,
        "text": text,
    }


def body_text(msg, limit):
    plain = html = None
    for part in msg.walk():
        if "attachment" in str(part.get("Content-Disposition") or ""):
            continue
        ctype = part.get_content_type()
        if ctype == "text/plain" and plain is None:
            plain = part
        elif ctype == "text/html" and html is None:
            html = part

    target = plain or html
    if target is None:
        return ""
    text = decode_payload(target)
    if target is html:
        text = re.sub(r"<(script|style).*?</\1>", " ", text, flags=re.S | re.I)
        text = re.sub(r"<[^>]+>", " ", text)
        text = (text.replace("&nbsp;", " ").replace("&ldquo;", "「")
                    .replace("&rdquo;", "」").replace("&amp;", "&"))
    text = re.sub(r"[ \t\r\f\v]+", " ", text)
    text = re.sub(r"\n\s*\n+", "\n", text)
    return text.strip()[:limit] if limit else text.strip()


# ---------------------------------------------------------------- 命令

def cmd_check(cfg, args):
    conn = connect(cfg)
    status, data = conn.select(cfg["folder"], readonly=True)
    if status != "OK":
        die("打不开文件夹 %s" % cfg["folder"])
    total = data[0].decode() if data and data[0] else "?"

    status, raw_folders = conn.list()
    folders = []
    if status == "OK":
        for raw in raw_folders:
            line = raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else str(raw)
            match = re.search(r'"([^"]*)"\s*$', line) or re.search(r"(\S+)\s*$", line)
            if match:
                folders.append(match.group(1))

    since = imap_date("-7d")
    status, recent = conn.search(None, "(SINCE %s)" % since)
    recent_count = len(recent[0].split()) if status == "OK" and recent and recent[0] else 0
    conn.logout()

    result = {
        "ok": True, "host": cfg["host"], "port": cfg["port"], "user": cfg["user"],
        "default_folder": cfg["folder"], "messages_in_folder": total,
        "messages_last_7_days": recent_count,
        "folders": [decode_folder(f) for f in folders],
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print("连接成功：%s → %s:%d" % (cfg["user"], cfg["host"], cfg["port"]))
        print("%s：共 %s 封，最近 7 天 %d 封" % (cfg["folder"], total, recent_count))
        print("文件夹：%s" % ", ".join(result["folders"]))


def cmd_folders(cfg, args):
    conn = connect(cfg)
    status, raw_folders = conn.list()
    if status != "OK":
        die("列文件夹失败")
    items = []
    for raw in raw_folders:
        line = raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else str(raw)
        match = re.search(r'"([^"]*)"\s*$', line) or re.search(r"(\S+)\s*$", line)
        if not match:
            continue
        wire = match.group(1)
        items.append({"name": decode_folder(wire), "wire": wire})
    conn.logout()

    if args.json:
        print(json.dumps({"ok": True, "folders": items}, ensure_ascii=False, indent=2))
    else:
        for item in items:
            print("%-16s %s" % (item["name"], item["wire"]))


def build_criteria(args):
    criteria = []
    if args.unread:
        criteria.append("UNSEEN")
    if args.since:
        criteria.append("SINCE %s" % imap_date(args.since))
    if args.before:
        criteria.append("BEFORE %s" % imap_date(args.before))
    if args.sender:
        criteria.append('FROM "%s"' % args.sender)
    if args.subject and args.subject.isascii():
        criteria.append('SUBJECT "%s"' % args.subject)
    if args.query and args.query.isascii():
        criteria.append('TEXT "%s"' % args.query)
    return criteria


def select_folder(conn, name):
    for candidate in (name, encode_folder(name)):
        try:
            status, data = conn.select(candidate, readonly=True)
            if status == "OK":
                return data
        except Exception:
            continue
    die("打不开文件夹：%s（用 mail folders 看可选值）" % name)


def cmd_search(cfg, args):
    conn = connect(cfg)
    select_folder(conn, args.folder or cfg["folder"])

    criteria = build_criteria(args) or ["ALL"]
    status, data = conn.search(None, "(%s)" % " ".join(criteria) if len(criteria) > 1 else criteria[0])
    if status != "OK":
        die("搜索失败：%s" % data)

    uids = data[0].split() if data and data[0] else []
    uids = uids[-args.scan:]

    # 需要本地过滤的情形：非 ASCII 关键词、附件、正文匹配
    needle = None
    if args.query and not args.query.isascii():
        needle = args.query.lower()
    if args.subject and not args.subject.isascii():
        needle = args.subject.lower()
    local_filter = bool(needle or args.attachment or args.match_any)

    results = []
    for uid in reversed(uids):
        if len(results) >= args.limit:
            break
        uid_str = uid.decode() if isinstance(uid, bytes) else str(uid)
        if local_filter:
            fetched = fetch_message(conn, uid)
            if not fetched:
                continue
            raw, flags = fetched
            msg = email.message_from_bytes(raw)
            info = describe(msg, uid_str, flags, 0 if args.match_any else 2000)
            if needle:
                haystack = (info["subject"] + " " + info["text"]).lower()
                if needle not in haystack:
                    continue
            if args.attachment and not info["attachments"]:
                continue
            if args.match_any:
                haystack = (info["subject"] + " " + info["text"]).lower()
                words = [w.strip().lower() for w in args.match_any.split(",") if w.strip()]
                if not any(w in haystack for w in words):
                    continue
            results.append(info)
        else:
            fetched = fetch_message(conn, uid)
            if not fetched:
                continue
            raw, flags = fetched
            msg = email.message_from_bytes(raw)
            results.append(describe(msg, uid_str, flags, 0))

    conn.logout()

    slim = [{k: v for k, v in item.items() if k != "text"} for item in results]
    if args.json:
        print(json.dumps({"ok": True, "count": len(slim), "messages": slim},
                         ensure_ascii=False, indent=2))
    else:
        print("%d 封" % len(slim))
        for item in slim:
            mark = "●" if item["unread"] else " "
            clip = ", ".join(a["name"] for a in item["attachments"])
            print("%s %-8s %-16s %-26s %s%s" % (
                mark, item["uid"], item["date"][5:16],
                item["from"][:26], item["subject"][:44],
                ("  [" + clip + "]") if clip else ""))


def cmd_read(cfg, args):
    conn = connect(cfg)
    select_folder(conn, args.folder or cfg["folder"])
    out = []
    for uid in args.uid.split(","):
        uid = uid.strip()
        if not uid:
            continue
        fetched = fetch_message(conn, uid)
        if not fetched:
            out.append({"uid": uid, "error": "读不到这封"})
            continue
        raw, flags = fetched
        msg = email.message_from_bytes(raw)
        out.append(describe(msg, uid, flags, args.chars))
    conn.logout()

    if args.json:
        print(json.dumps({"ok": True, "messages": out}, ensure_ascii=False, indent=2))
        return
    for item in out:
        if item.get("error"):
            print("[%s] %s" % (item["uid"], item["error"]))
            continue
        print("=" * 60)
        print("UID   ：%s" % item["uid"])
        print("日期  ：%s" % item["date"])
        print("发件人：%s" % item["from"])
        print("收件人：%s" % item["to"])
        print("主题  ：%s" % item["subject"])
        if item["attachments"]:
            print("附件  ：%s" % ", ".join(a["name"] for a in item["attachments"]))
        print("-" * 60)
        print(item["text"] or "（无纯文本正文）")


def cmd_save(cfg, args):
    conn = connect(cfg)
    select_folder(conn, args.folder or cfg["folder"])
    fetched = fetch_message(conn, args.uid)
    if not fetched:
        die("读不到 uid=%s" % args.uid)
    raw, flags = fetched
    msg = email.message_from_bytes(raw)
    info = describe(msg, args.uid, flags, 0)

    out = os.path.expanduser(args.out)
    os.makedirs(os.path.dirname(os.path.abspath(out)) or ".", exist_ok=True)
    if out.endswith(".eml"):
        with open(out, "wb") as f:
            f.write(raw)
    else:
        with open(out, "w", encoding="utf-8") as f:
            f.write("# %s\n\n" % info["subject"])
            f.write("- 日期：%s\n- 发件人：%s\n- 收件人：%s\n" %
                    (info["date"], info["from"], info["to"]))
            if info["attachments"]:
                f.write("- 附件：%s\n" % ", ".join(a["name"] for a in info["attachments"]))
            f.write("\n---\n\n%s\n" % info["text"])
    conn.logout()
    print(json.dumps({"ok": True, "path": out, "bytes": os.path.getsize(out)},
                     ensure_ascii=False))


def cmd_attach(cfg, args):
    conn = connect(cfg)
    select_folder(conn, args.folder or cfg["folder"])
    fetched = fetch_message(conn, args.uid)
    if not fetched:
        die("读不到 uid=%s" % args.uid)
    raw, _ = fetched
    msg = email.message_from_bytes(raw)

    outdir = os.path.expanduser(args.out)
    os.makedirs(outdir, exist_ok=True)
    saved = []
    for part in msg.walk():
        name = part.get_filename()
        if not name:
            continue
        safe = re.sub(r"[^\w.\-]", "_", decode_mime(name)) or "attachment"
        path = os.path.join(outdir, "%s-%s" % (args.uid, safe))
        with open(path, "wb") as f:
            f.write(part.get_payload(decode=True) or b"")
        saved.append({"name": decode_mime(name), "path": path,
                      "type": part.get_content_type(),
                      "bytes": os.path.getsize(path)})
    conn.logout()

    if args.json:
        print(json.dumps({"ok": True, "saved": saved}, ensure_ascii=False, indent=2))
    else:
        if not saved:
            print("这封没有附件")
        for item in saved:
            print("%s (%d bytes) → %s" % (item["name"], item["bytes"], item["path"]))


def main():
    parser = argparse.ArgumentParser(prog="mail", description="只读邮箱工具")
    parser.add_argument("--config", default=DEFAULT_CONFIG, help="配置文件路径")
    sub = parser.add_subparsers(dest="command")

    def folder_arg(p):
        p.add_argument("--folder", help="邮箱文件夹，默认值见 config")

    check = sub.add_parser("check", help="账号连通性")
    check.add_argument("--json", action="store_true")

    folders = sub.add_parser("folders", help="文件夹列表")
    folders.add_argument("--json", action="store_true")

    search = sub.add_parser("search", help="邮件列表（不含正文）")
    folder_arg(search)
    search.add_argument("--query", help="全文关键词（非 ASCII 会退化为本地过滤）")
    search.add_argument("--sender", help="发件人包含")
    search.add_argument("--subject", help="主题包含")
    search.add_argument("--since", help="起始日期：2026-11-01 / 7d（七天前）/ today")
    search.add_argument("--before", help="截止日期：2026-11-30")
    search.add_argument("--unread", action="store_true", help="只看未读")
    search.add_argument("--attachment", action="store_true", help="只看带附件的")
    search.add_argument("--match-any", help="逗号分隔的关键词，命中任意一个（标题+正文）")
    search.add_argument("--scan", type=int, default=200, help="最多检查多少封")
    search.add_argument("--limit", type=int, default=30, help="最多返回多少封")
    search.add_argument("--json", action="store_true")

    read = sub.add_parser("read", help="读正文")
    folder_arg(read)
    read.add_argument("--uid", required=True, help="单个 uid，或逗号分隔多个")
    read.add_argument("--chars", type=int, default=2000, help="每封正文最多多少字符，0 = 全文")
    read.add_argument("--json", action="store_true")

    save = sub.add_parser("save", help="存成 .md 或 .eml")
    folder_arg(save)
    save.add_argument("--uid", required=True)
    save.add_argument("--out", required=True)
    save.add_argument("--json", action="store_true")

    attach = sub.add_parser("attach", help="下载附件")
    folder_arg(attach)
    attach.add_argument("--uid", required=True)
    attach.add_argument("--out", default="./attachments")
    attach.add_argument("--json", action="store_true")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    cfg = load_config(args.config)
    handlers = {
        "check": cmd_check, "folders": cmd_folders, "search": cmd_search,
        "read": cmd_read, "save": cmd_save, "attach": cmd_attach,
    }
    handlers[args.command](cfg, args)


if __name__ == "__main__":
    main()
